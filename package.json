{
  "name": "dsh-product-previs",
  "version": "0.1.1",
  "type": "module",
  "description": "产品白模导演预演：三维布景、机位、产品与人物动作、AI 编排和 MP4 导出",
  "license": "MIT",
  "main": "host/index.mjs",
  "exports": {
    ".": "./host/index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "host",
    "dist",
    "render-dist",
    "src",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/build-core.mjs && node scripts/build-render.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "test:host": "node --test tests/host.test.mjs tests/client.test.mjs tests/camera.test.mjs && node --experimental-strip-types --test tests/retime.test.mjs",
    "render": "node host/render-cli.mjs",
    "test:client": "node --test tests/client.test.mjs",
    "test:camera": "node --test tests/camera.test.mjs",
    "audit:camera": "node scripts/audit-frames.mjs",
    "stage:shots": "node scripts/stage-shots.mjs",
    "handoff": "node scripts/handoff-frames.mjs && node scripts/handoff-prompts.mjs",
    "test:retime": "node --experimental-strip-types --test tests/retime.test.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "@react-three/drei": "10.7.9",
    "three": "0.186.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.519",
    "@remotion/three": "4.0.519",
    "@remotion/renderer": "4.0.519",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.519",
    "@types/node": "^22.14.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "6.4.3",
    "typescript": "5.9.3",
    "vitest": "^3.0.0",
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.0-rc.1 <0.3.0-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
